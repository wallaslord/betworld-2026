generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  avatar                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  subscription          Subscription?
  payments              Payment[]
  favorites             Favorite[]
  notifications         Notification[]
  bracketPicks          BracketPick[]
  bracketRanking        BracketRanking?
  simulationResults     SimulationResult[]
  savedPredictions      SavedPrediction[]
  @@map("users")
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  plan                  String
  status                String    @default("active")
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  stripeSubscriptionId  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("subscriptions")
}

model Payment {
  id                    String    @id @default(cuid())
  userId                String
  amount                Float
  currency              String    @default("EUR")
  status                String
  stripePaymentId       String?
  method                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("payments")
}

model Team {
  id                    String    @id @default(cuid())
  name                  String
  code                  String    @unique
  flag                  String?
  logo                  String?
  filaRanking           Int?
  manager               String?
  group                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  players               Player[]
  homeMatches           Match[]   @relation("homeTeam")
  awayMatches           Match[]   @relation("awayTeam")
  standings             Standing[]
  @@map("teams")
}

model Player {
  id                    String    @id @default(cuid())
  firstName             String
  lastName              String
  position              String
  number                Int?
  photo                 String?
  dateOfBirth           DateTime?
  height                Int?
  weight                Int?
  club                  String?
  teamId                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  team                  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stats                 PlayerStats?
  probabilities         PlayerProbability?
  events                MatchEvent[]  @relation("player")
  favoriteBy            Favorite[]
  @@map("players")
}

model PlayerStats {
  id                    String    @id @default(cuid())
  playerId              String    @unique
  clubMatches           Int       @default(0)
  clubGoals             Int       @default(0)
  clubAssists           Int       @default(0)
  nationalMatches       Int       @default(0)
  nationalGoals         Int       @default(0)
  nationalAssists       Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  player                Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@map("player_stats")
}

model PlayerProbability {
  id                    String    @id @default(cuid())
  playerId              String    @unique
  scoreGoal             Float     @default(0)
  assist                Float     @default(0)
  motm                  Float     @default(0)
  redCard               Float     @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  player                Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@map("player_probabilities")
}

model Match {
  id                    String    @id @default(cuid())
  homeTeamId            String
  awayTeamId            String
  status                String    @default("scheduled")
  matchDay              DateTime
  stage                 String
  group                 String?
  venue                 String?
  homeScore             Int       @default(0)
  awayScore             Int       @default(0)
  possession            Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  homeTeam              Team      @relation("homeTeam", fields: [homeTeamId], references: [id])
  awayTeam              Team      @relation("awayTeam", fields: [awayTeamId], references: [id])
  events                MatchEvent[]
  predictions           MatchPrediction[]
  favorites             Favorite[]
  bracketPicks          BracketPick[]
  @@map("matches")
}

model MatchEvent {
  id                    String    @id @default(cuid())
  matchId               String
  type                  String
  minute                Int
  team                  String
  playerId              String?
  playerName            String
  createdAt             DateTime  @default(now())
  match                 Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player                Player?   @relation("player", fields: [playerId], references: [id])
  @@map("match_events")
}

model MatchPrediction {
  id                    String    @id @default(cuid())
  matchId               String
  homeWinProb           Float
  drawProb              Float
  awayWinProb           Float
  predictedScore        String
  confidence            Float
  updatedAt             DateTime  @updatedAt
  match                 Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@map("match_predictions")
  @@unique([matchId])
}

model SavedPrediction {
  id                    String    @id @default(cuid())
  userId                String
  prediction            String
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("saved_predictions")
}

model Standing {
  id                    String    @id @default(cuid())
  teamId                String
  group                 String
  position              Int
  played                Int       @default(0)
  won                   Int       @default(0)
  drawn                 Int       @default(0)
  lost                  Int       @default(0)
  points                Int       @default(0)
  updatedAt             DateTime  @updatedAt
  team                  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@map("standings")
  @@unique([teamId, group])
}

model News {
  id                    String    @id @default(cuid())
  title                 String
  slug                  String    @unique
  category              String
  summary               String
  content               String
  image                 String?
  author                String?
  isAiGenerated         Boolean   @default(false)
  views                 Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  publishedAt           DateTime?
  tags                  NewsTag[]
  @@map("news")
}

model NewsTag {
  id                    String    @id @default(cuid())
  newsId                String
  tag                   String
  news                  News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  @@map("news_tags")
}

model Favorite {
  id                    String    @id @default(cuid())
  userId                String
  matchId               String?
  teamId                String?
  playerId              String?
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match                 Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team                  Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player                Player?   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@map("favorites")
}

model Notification {
  id                    String    @id @default(cuid())
  userId                String
  type                  String
  title                 String
  message               String
  read                  Boolean   @default(false)
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notifications")
}

model BracketPick {
  id                    String    @id @default(cuid())
  userId                String
  matchId               String
  prediction            String
  points                Int       @default(0)
  correct               Boolean?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match                 Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@map("bracket_picks")
  @@unique([userId, matchId])
}

model BracketRanking {
  id                    String    @id @default(cuid())
  userId                String    @unique
  totalPoints           Int       @default(0)
  rank                  Int       @default(0)
  country               String?
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("bracket_rankings")
}

model SimulationResult {
  id                    String    @id @default(cuid())
  userId                String
  results               String    @db.Text
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("simulation_results")
}
